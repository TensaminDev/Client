{
  "name": "tensamin",
  "version": "0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "format": "bunx prettier --write .",
    "lint": "bun scripts/lint-packages.ts",
    "build:all": "bun run build:packages && bun run build:web && bun run build:mobile && bun run build:desktop",
    "build:packages": "bun scripts/build-packages.ts",
    "dev:web": "cd apps/web && bun dev",
    "build:web": "bun run build:packages && cd apps/web && bun run build",
    "preview:web": "cd apps/web && bun run preview",
    "dev:mobile": "cd apps/tauri && bun dev:mobile",
    "build:mobile": "cd apps/tauri && bun run build:mobile",
    "dev:desktop": "cd apps/tauri && bun dev:desktop",
    "build:desktop": "cd apps/tauri && bun run build:desktop"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  },
  "overrides": {
    "@tensamin/ui": "https://git.methanium.net/tensamin/ui/archive/0.0.25.tar.gz",
    "@tensamin/ttp-core": "https://git.methanium.net/tensamin/ttp/archive/0.0.3.tar.gz"
  },
  "dependencies": {
    "@tensamin/ui": "*",
    "@tensamin/ttp-core": "*"
  }
}
