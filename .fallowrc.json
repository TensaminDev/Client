{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}",
    "apps/tauri/render-version.ts",
    "packages/**/*.test.ts"
  ],
  "workspaces": {
    "packages": ["packages/*", "apps/*"]
  },
  "duplicates": {
    "minOccurrences": 3,
    "ignore": ["**/scripts/**", "**.test.ts", "licenses/**"]
  },
  "rules": {}
}
