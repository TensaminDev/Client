{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "mtp:default",
    "mtp:encrypted-pipes",
    "mtp:background-service",
    "mtp:export-credentials",
    "mtp:allow-mtp-stop",
    "opener:default",
    "deep-link:default",
    "notification:default",
    "log:default"
  ]
}
