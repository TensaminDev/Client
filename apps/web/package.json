{
  "name": "@tensamin/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "format": "bunx prettier --write .",
    "lint": "eslint src",
    "dev": "vite --port 3000 --host 0.0.0.0",
